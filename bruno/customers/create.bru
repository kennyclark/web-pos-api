meta {
  name: create
  type: http
  seq: 2
}

post {
  url: {{process.env.BASE_URL}}/api/customers
  body: json
  auth: inherit
}

body:json {
  {
    "name": "New Customer",
    "address": "Philippines",
    "contact_number": "091234567890"
  }
}

script:post-response {
  const customerId = res.body.data.id
  bru.setVar("customerId", customerId)
}

settings {
  encodeUrl: true
  timeout: 0
}
