meta {
  name: create
  type: http
  seq: 2
}

post {
  url: {{process.env.BASE_URL}}/api/vendors
  body: json
  auth: inherit
}

body:json {
  {
    "name": "New Vendor",
    "address": "Philippines",
    "contact_person": "Juan dela Cruz",
    "contact_number": "091234567890"
  }
}

script:post-response {
  const vendorId = res.body.data.id
  bru.setVar("vendorId", vendorId)
}

settings {
  encodeUrl: true
  timeout: 0
}
